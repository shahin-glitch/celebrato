# Celebrato Environment Variables
# Copy this file to .env and fill in your values

# Optional: Google Gemini API Key for live AI plan generation
# Leave empty to use Celebrato's high-precision deterministic offline AI engine
# Get your key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# App Configuration (optional overrides)
VITE_APP_NAME=Celebrato
VITE_APP_VERSION=1.0.0
